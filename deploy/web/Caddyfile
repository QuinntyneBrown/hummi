# Serves the single-page Angular build.
(spa) {
	# index.html and SPA routes must revalidate so a deploy shows up at once; hashed assets can be cached.
	@entry not path *.js *.css *.png *.jpg *.svg *.ico *.webp *.mp3 *.ogg *.flac *.woff2
	header @entry Cache-Control "no-cache"
	root * {args[0]}
	try_files {path} /index.html
	file_server
	# Only index.html carries the @@{.Req.Host}@@ placeholders (Open Graph URLs); other files pass through untouched.
	@index path / /index.html
	templates @index {
		between "@@{" "}@@"
	}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Every host in SITE_ADDRESS gets a certificate; all but the canonical one (www. on a real domain,
	# set by the deploy workflow) redirect to it, so the bare domain lands on www.
	@noncanonical not host {$CANONICAL_HOST:localhost}
	redir @noncanonical https://{$CANONICAL_HOST:localhost}{uri} permanent

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /media/* {
		reverse_proxy api:8080
	}

	handle {
		import spa /srv/app
	}
}
