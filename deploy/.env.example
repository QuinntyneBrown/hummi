# Copy to /opt/hummi/.env on the server. Never commit the real file.
IMAGE_PREFIX=ghcr.io/quinntynebrown
IMAGE_TAG=latest
# Hosts Caddy serves and holds certificates for. The deploy workflow rewrites this line from SITE_HOST on every deploy.
SITE_ADDRESS=hummi.example, www.hummi.example

ConnectionStrings__Hummi=Server=tcp:<server>.database.windows.net,1433;Database=Hummi;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30
Auth__SigningKey=<64 random characters>
Email__SigningKey=<64 random characters>
App__BaseUrl=https://www.hummi.example
# Account emails (ADR 0010): the SMTP relay that sends confirmation links.
Email__Smtp__Host=smtp.example.com
Email__Smtp__Port=587
Email__Smtp__UserName=<smtp user>
Email__Smtp__Password=<smtp password>
Email__Smtp__EnableSsl=true
Email__From=Hummi <hello@hummi.example>
# Track reports (ADR 0018): the shared key reviewers send as X-Reviewer-Key; leave empty to turn the reviewer endpoints off.
Reports__ReviewerKey=<long random key>
# Banners (ADR 0019): the scheduled maintenance window shown to everyone, for example "Sunday 1 Nov, 02:00 to 02:30 UTC"; empty for none.
Status__Maintenance=
