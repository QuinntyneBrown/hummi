hide empty members
title Class structure — Manage an owned playlist

class Playlist {
  +Guid Id
  +Guid OwnerId
  +string Name
  +bool IsPublic
  +IReadOnlyList<PlaylistEntry> Entries
  +{static} Create(owner: Guid, name: PlaylistName, isPublic: bool): Playlist
  +Rename(by: Guid, name: PlaylistName): Result
  +AddTrack(by: Guid, trackId: Guid): Result<int>
  +RemoveTracks(by: Guid, entryIds: Guid[]): Result
  +Delete(by: Guid): Result
  +CanView(listener: Guid?): bool
}
class PlaylistEntry {
  +Guid Id
  +Guid TrackId
  +int Position
}
class PlaylistName <<value object>> {
  +string Value
  +{static} Create(raw: string): Result<PlaylistName>
}
Playlist "1" *-- "*" PlaylistEntry
Playlist --> PlaylistName

class PlaylistDetailDto {
  +Guid Id
  +string Name
  +bool IsOwner
  +bool IsPublic
  +string OwnerName
  +int TrackCount
  +int DurationSeconds
  +IReadOnlyList<PlaylistEntryDto> Entries
}
class RemovePlaylistEntriesCommand {
  +Guid PlaylistId
  +IReadOnlyList<Guid> EntryIds
}
GetPlaylistQueryHandler ..> PlaylistDetailDto : returns
RemovePlaylistEntriesCommandHandler --> Playlist : RemoveTracks
@enduml
