@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Like tracks and follow artists

class TrackLike {
  +Guid ListenerId
  +Guid TrackId
  +DateTimeOffset CreatedAt
}
class ArtistFollow {
  +Guid ListenerId
  +Guid ArtistId
  +DateTimeOffset CreatedAt
}
class SetTrackLikeCommand {
  +Guid TrackId
}
class SetTrackLikeCommandHandler {
  +Handle(c: SetTrackLikeCommand): Task<Result>
}
class SetArtistFollowCommandHandler {
  +Handle(c: SetArtistFollowCommand): Task<Result>
}
class LibraryStore {
  +likedIds: Signal<Set<string>>
  +followedIds: Signal<Set<string>>
  +toggleLike(track): Promise<void>
  +toggleFollow(artist): Promise<void>
}
SetTrackLikeCommandHandler ..> SetTrackLikeCommand : handles
SetTrackLikeCommandHandler ..> TrackLike : creates
SetArtistFollowCommandHandler ..> ArtistFollow : creates
@enduml
