@startuml
title UML sequence behaviour — Create a playlist
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "PlaylistFormDialog" as dlg
  participant "SignInGate" as gate
  participant "PlaylistsApi" as client
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "PlaylistsController" as ctl
end box
box "Backend — Hummi Application and Domain" #ECFDF3
  participant "CreatePlaylistCommandHandler" as cmd
  participant "PlaylistNameValidator" as val
end box
box "Backend — Hummi Infrastructure" #FFF4E5
  participant "HummiDbContext" as ctx
  database "Hummi database" as db
end box
u -> dlg : Open New playlist
dlg -> gate : requireSession() (L2-032)
dlg --> u : "Playlists are private until you share them.", name, Make it public unchecked (L2-021)
u -> dlg : Submit with empty name
dlg --> u : "Give your playlist a name", nothing created (L2-021)
u -> dlg : Enter "Late-night coding", Create playlist
dlg -> dlg : Name read-only, option and Cancel disabled, "Saving…" (L2-021)
dlg -> client : create(name, isPublic=false)
client -> ctl : POST /api/playlists
ctl -> val : Validate name length 1..60 (L2-021)
alt over 60 characters
  val --> ctl : Invalid
  ctl --> client : 400 ProblemDetails, not created
else valid
  ctl -> cmd : Send CreatePlaylistCommand
  cmd -> ctx : Add Playlist(IsPublic = false)
  ctx -> db : INSERT
  ctl --> client : 201 Location
  client --> dlg : Created
else server error
  ctl --> client : 500
  dlg --> u : "That didn’t work", typed name kept (L2-021)
end
@enduml
