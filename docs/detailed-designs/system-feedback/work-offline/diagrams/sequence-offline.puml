@startuml
title UML sequence behaviour — Use Hummi offline
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "ngsw Service Worker" as sw
  participant "SavedAudioCache" as audiocache
  participant "PlayerStore" as player
  participant "ConnectivityService" as net
  participant "OfflinePage" as offline
end box
u -> sw : Navigate while offline
alt page cached
  sw --> u : Cached shell and data with offline banner (L2-043)
else not cached
  sw --> offline : Fallback route
  offline --> u : "You’re offline", Retry, Open saved tracks (L2-043)
end
u -> player : Play a track
player -> net : online()
net --> player : false
player -> audiocache : isSaved(id)
alt saved
  audiocache --> player : Blob URL
  player --> u : Plays (L2-043)
else not saved
  player --> u : Row shows it needs a connection (L2-043)
end
@enduml
