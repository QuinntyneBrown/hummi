@startuml
title UML sequence behaviour — Resolve and change the theme
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "SettingsPage" as page
  participant "ThemeService" as theme
  participant "LogoComponent" as logo
  participant "SettingsApi" as client
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "SettingsController" as ctl
end box
participant "Browser and device" as device
theme -> device : matchMedia(prefers-color-scheme: dark)
device --> theme : true
theme -> theme : Device preference resolves to dark (L2-049)
theme --> logo : data-theme=dark, cream wordmark (L2-049)
u -> page : Choose Light, Save changes
page -> theme : set(Light)
theme --> logo : data-theme=light, coral wordmark regardless of device (L2-049)
page -> client : update(theme = Light)
client -> ctl : PUT /api/me/settings
@enduml
