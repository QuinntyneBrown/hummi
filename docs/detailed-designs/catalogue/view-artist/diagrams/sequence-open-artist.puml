@startuml
title UML sequence behaviour — Open an artist page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "ArtistPage" as page
  participant "ArtistsApi" as client
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "ArtistsController" as ctl
end box
box "Backend — Hummi.Worker application" #D1FADF
  participant "MonthlyListenersJob" as job
end box
box "Backend — Hummi Application and Domain" #ECFDF3
  participant "GetArtistQueryHandler" as q
end box
box "Backend — Hummi Infrastructure" #FFF4E5
  participant "HummiDbContext" as ctx
  database "Hummi database" as db
end box
u -> page : Open /artists/lumen-fox
page -> client : get("lumen-fox")
client -> ctl : GET /api/artists/lumen-fox
ctl -> q : Send GetArtistQuery
q -> ctx : Artist, popular tracks, releases, follow
ctx -> db : SELECT
db --> ctx : Rows
ctx --> q : Entities
q --> ctl : Result<ArtistDetailDto>
ctl --> client : 200, or 404
client --> page : Artist
alt no published tracks
  page --> u : "No tracks released yet", Follow (L2-010)
else
  page --> u : "48,210 monthly listeners", "Artist · openmusic-3b", Play, Follow, Share, Popular, Releases (L2-010)
end
job -> ctx : Recount distinct listeners in last 30 days
ctx -> db : UPDATE Artists SET MonthlyListeners
@enduml
