@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — View an artist

class Artist {
  +Guid Id
  +string Slug
  +string Name
  +string Description
  +string ModelName
  +int MonthlyListeners
  +SetMonthlyListeners(count: int)
}
class Album {
  +Guid Id
  +string Slug
  +string Title
  +int Year
  +Guid ArtistId
  +bool Published
}
class ArtistDetailDto {
  +string Slug
  +string Name
  +string ModelName
  +int MonthlyListeners
  +string Description
  +bool Following
  +IReadOnlyList<TrackSummaryDto> Popular
  +IReadOnlyList<AlbumTileDto> Releases
}
class GetArtistQueryHandler {
  +Handle(q: GetArtistQuery): Task<Result<ArtistDetailDto>>
}
class AlbumTileDto {
  +string Slug
  +string Title
  +int Year
  +int TrackCount
}
class MonthlyListenersJob {
  +Interval: TimeSpan = 1 hour
  +ExecuteAsync(ct: CancellationToken): Task
}
class RefreshMonthlyListenersCommandHandler {
  +Handle(c: RefreshMonthlyListenersCommand): Task<Result<int>>
}
Artist "1" --> "*" Album : releases
GetArtistQueryHandler --> Artist : loads
GetArtistQueryHandler ..> ArtistDetailDto : returns
ArtistDetailDto --> AlbumTileDto
MonthlyListenersJob ..> RefreshMonthlyListenersCommandHandler : sends command
RefreshMonthlyListenersCommandHandler --> Artist : updates MonthlyListeners
@enduml
