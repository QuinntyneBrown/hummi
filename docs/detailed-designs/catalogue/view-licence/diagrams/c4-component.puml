@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View licence and credit

Container_Boundary(spa, "Hummi web application") {
  Component(page, "LicencePage", "Routed component in @hummi/catalogue", "Renders the header, the info hm-alert with\nthe credit line, the Licences on Hummi\nhm-table and the Back to {title} link")
  Component(terms, "LICENCE_TERMS", "Constant in @hummi/catalogue", "Maps each Licence to its label, permissions\nand conditions")
  Component(client, "TracksApi", "Typed HTTP service in @hummi/api", "Calls GET /api/tracks/{slug}")
}
Container_Boundary(api, "Hummi.Api") {
  Component(ctl, "TracksController", "ASP.NET Core controller", "Serves the same TrackDetailDto as the track\npage")
  Component(q, "GetTrackQueryHandler", "MediatR query handler", "Supplies title, artist, model and licence")
  Component(ctx, "HummiDbContext", "EF Core DbContext", "Implements the IHummiDbContext port from\nApplication/Abstractions and maps entities\nto tables")
}
ContainerDb(db, "Hummi database", "Azure SQL", "Tracks")
Rel(page, client, "get('slow-orbit')")
Rel(client, ctl, "GET /api/tracks/slow-orbit")
Rel(ctl, q, "Send GetTrackQuery")
Rel(q, ctx, "Load track")
Rel(ctx, db, "SELECT")
Rel(page, terms, "Lookup Cc0")
@enduml
