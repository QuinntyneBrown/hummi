@startuml
title UML sequence behaviour — Open and play an album
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "AlbumPage" as page
  participant "AlbumsApi" as client
  participant "PlayerStore" as player
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "AlbumsController" as ctl
end box
box "Backend — Hummi Application and Domain" #ECFDF3
  participant "GetAlbumQueryHandler" as q
end box
box "Backend — Hummi Infrastructure" #FFF4E5
  participant "HummiDbContext" as ctx
  database "Hummi database" as db
end box
u -> page : Open /albums/mas-on-the-avenue
page -> client : get("mas-on-the-avenue")
client -> ctl : GET /api/albums/mas-on-the-avenue
ctl -> q : Send GetAlbumQuery
q -> ctx : Album with tracks by Position
ctx -> db : SELECT
db --> ctx : Rows
ctx --> q : Album
q --> ctl : Result<AlbumDetailDto>
ctl --> client : 200 "2026 · 2 tracks · 8 min · CC0 1.0 (public domain)" (L2-011)
client --> page : Album
page --> u : Header "Kaiso Collective · Album", actions, track list (L2-011)
u -> page : Activate Play
page -> player : playList(album.tracks, 0)
@enduml
