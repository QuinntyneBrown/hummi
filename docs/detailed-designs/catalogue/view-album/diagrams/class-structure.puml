@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — View an album

class Album {
  +Guid Id
  +string Slug
  +string Title
  +int Year
  +Guid ArtistId
  +bool Published
  +Publish(tracks: IReadOnlyCollection<Track>)
}
class Track {
  +Guid? AlbumId
  +int AlbumPosition
  +int DurationSeconds
  +Licence Licence
}
class AlbumDetailDto {
  +string Slug
  +string Title
  +int Year
  +ArtistRefDto Artist
  +string Summary
  +IReadOnlyList<TrackSummaryDto> Tracks
}
class GetAlbumQueryHandler {
  +Handle(q: GetAlbumQuery): Task<Result<AlbumDetailDto>>
}
Album "1" o-- "1..*" Track : AlbumId, AlbumPosition
GetAlbumQueryHandler --> Album : loads
GetAlbumQueryHandler ..> AlbumDetailDto : returns
@enduml
