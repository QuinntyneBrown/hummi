@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — View a track

enum Licence {
  Cc0
  CcBy4
  CcBySa4
}
class Track {
  +Guid Id
  +string Slug
  +string Title
  +Guid ArtistId
  +Guid? AlbumId
  +Guid? GenreId
  +int DurationSeconds
  +Licence Licence
  +int AlbumPosition
  +long PlayCount
  +bool Withdrawn
  +byte[] Waveform
  +bool IsPlayable
}
class Artist {
  +string Slug
  +string Name
  +string ModelName
}
Track --> Licence
Track --> Artist

class GetTrackQuery {
  +string Slug
}
class GetTrackQueryHandler {
  +Handle(q: GetTrackQuery): Task<Result<TrackDetailDto>>
}
class TrackDetailDto {
  +string Slug
  +string Title
  +int DurationSeconds
  +ArtistRefDto Artist
  +AlbumRefDto Album
  +string Genre
  +string GeneratedWith
  +Licence Licence
  +string LicenceLabel
  +long Plays
  +bool Playable
  +bool Liked
  +IReadOnlyList<int> Waveform
  +IReadOnlyList<TrackSummaryDto> MoreFromArtist
  +IReadOnlyList<TrackSummaryDto> Similar
}
GetTrackQueryHandler ..> GetTrackQuery : handles
GetTrackQueryHandler --> Track : loads
GetTrackQueryHandler ..> TrackDetailDto : returns
@enduml
