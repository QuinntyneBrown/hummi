@startuml
title UML sequence behaviour — Render a track list
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "TrackListComponent" as list
  participant "TrackRowComponent" as row
  participant "Host page" as host
end box
host -> list : tracks, currentTrackId = player.currentTrack().id
list -> row : One row per track with position
row -> row : current ? equaliser "Playing" : position number (L2-005)
row -> row : meta() = "Lumen Fox · 4:12" (L2-005)
row -> row : likeLabel() = liked ? "Remove like from {title}" : "Like {title}" (L2-005)
row --> list : Row with truncated title (L2-005)
list --> host : Rendered list
u -> row : Activate the like button
row -> host : like(track)
host --> u : Like flow of the library subsystem (L2-018)
@enduml
