@startuml
title UML sequence behaviour — Load Browse
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "BrowsePage" as page
  participant "GenresApi" as client
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "GenresController" as ctl
end box
box "Backend — Hummi Application and Domain" #ECFDF3
  participant "GetGenreDirectoryQueryHandler" as q
end box
box "Backend — Hummi Infrastructure" #FFF4E5
  participant "HummiDbContext" as ctx
  database "Hummi database" as db
end box
u -> page : Open /browse
page -> client : getDirectory()
client -> ctl : GET /api/genres
ctl -> q : Send GetGenreDirectoryQuery
q -> ctx : Count published tracks per genre
ctx -> db : SELECT ... GROUP BY GenreId
db --> ctx : Counts
ctx --> q : Genres and counts
q --> ctl : Result<GenreDirectoryDto>
alt success
  ctl --> client : 200 GenreDirectoryDto
  client --> page : Directory
  page --> u : "10 genres · 4,812 openly licensed tracks", Moods, All genres (L2-003)
else failure
  ctl --> client : 5xx ProblemDetails
  client --> page : Error
  page --> u : Error block "Genres didn’t load" (L2-003)
end
u -> page : Activate a genre tile or mood chip
page --> u : Navigate to /genres/{slug} (L2-003)
@enduml
