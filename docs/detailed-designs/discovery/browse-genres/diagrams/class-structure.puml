@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Browse genres

class Genre {
  +Guid Id
  +string Slug
  +string Name
  +string Description
  +int Position
  +int Tone
  +{static} int MoodCount = 7
  +{static} All(): IReadOnlyList<Genre>
}
class GenreDirectoryDto {
  +int GenreCount
  +int OpenlyLicensedTrackCount
  +IReadOnlyList<GenreTileDto> Moods
  +IReadOnlyList<GenreTileDto> Genres
}
class GenreTileDto {
  +string Slug
  +string Name
  +int Tone
  +int TrackCount
}
class GetGenreDirectoryQuery
class GetGenreDirectoryQueryHandler {
  +Handle(q: GetGenreDirectoryQuery): Task<Result<GenreDirectoryDto>>
}
GetGenreDirectoryQueryHandler ..> GetGenreDirectoryQuery : handles
GetGenreDirectoryQueryHandler ..> Genre : reads
GetGenreDirectoryQueryHandler ..> GenreDirectoryDto : returns
GenreDirectoryDto "1" *-- "*" GenreTileDto
note right of GenreDirectoryDto : Moods are the first seven\ngenres by Position
@enduml
