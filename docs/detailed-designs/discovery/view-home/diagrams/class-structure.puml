@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — View Home

class HomeSummaryDto {
  +string DisplayName
  +DateOnly Today
  +int NewTracksFromFollowed
  +bool HasHistory
}
class FeaturedMixDto {
  +string SeedTrackTitle
  +int SimilarCount
  +IReadOnlyList<TrackSummaryDto> Tracks
}
class TrackSummaryDto {
  +Guid Id
  +string Slug
  +string Title
  +string ArtistName
  +int DurationSeconds
  +string CoverUrl
  +bool Liked
}
class ArtistTileDto {
  +string Slug
  +string Name
  +int MonthlyListeners
}
class GetFeaturedAlbumQuery {
  +Guid ListenerId
}
class GetFeaturedAlbumQueryHandler {
  +Handle(q: GetFeaturedAlbumQuery): Task<Result<FeaturedMixDto>>
}
class Album.Feature {
  +Build(history: IReadOnlyList<PlayEvent>, candidates: IQueryable<Track>): FeaturedMix
}
class PlayEvent {
  +Guid ListenerId
  +Guid TrackId
  +DateTimeOffset PlayedAt
}
class HomeApi cache {
  +summary: Signal<ShelfState<HomeSummaryDto>>
  +featured: Signal<ShelfState<FeaturedMixDto>>
  +recent: Signal<ShelfState<TrackSummaryDto[]>>
  +newThisWeek: Signal<ShelfState<TrackSummaryDto[]>>
  +artists: Signal<ShelfState<ArtistTileDto[]>>
  +load(): void
  +retry(shelf: HomeShelf): void
}
GetFeaturedAlbumQueryHandler ..> GetFeaturedAlbumQuery : handles
GetFeaturedAlbumQueryHandler --> Album.Feature : uses
Album.Feature ..> PlayEvent : reads
GetFeaturedAlbumQueryHandler ..> FeaturedMixDto : returns
FeaturedMixDto "1" *-- "*" TrackSummaryDto
HomeApi cache ..> HomeSummaryDto
HomeApi cache ..> FeaturedMixDto
HomeApi cache ..> ArtistTileDto
@enduml
