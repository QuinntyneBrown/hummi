@startuml
title UML sequence behaviour — Load and sort a genre
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "GenrePage" as page
  participant "GenresApi" as client
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "GenresController" as ctl
end box
box "Backend — Hummi Application and Domain" #ECFDF3
  participant "GetGenreTracksQueryHandler" as q
end box
box "Backend — Hummi Infrastructure" #FFF4E5
  participant "HummiDbContext" as ctx
  database "Hummi database" as db
end box
u -> page : Open /genres/ambient
page -> client : getTracks("ambient", Newest)
client -> ctl : GET /api/genres/ambient/tracks?sort=newest
ctl -> q : Send GetGenreTracksQuery
q -> ctx : Published tracks of genre ORDER BY PublishedAt DESC
ctx -> db : SELECT
db --> ctx : Rows
ctx --> q : Tracks
q --> ctl : Result<GenreTracksDto>
ctl --> client : 200 GenreTracksDto, or 404 for unknown slug
client --> page : Tracks
alt TrackCount is 0
  page --> u : "No Ambient tracks yet" with Browse genres (L2-004)
else tracks exist
  page --> u : Header "1,204 tracks · ...", Newest pressed (L2-004)
end
u -> page : Select Most played
page -> client : getTracks("ambient", MostPlayed)
client -> ctl : GET ...?sort=most-played
ctl --> client : 200 ordered by PlayCount (L2-004)
client --> page : Tracks
page --> u : Most played pressed, list reordered
@enduml
