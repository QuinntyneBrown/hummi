@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — View a genre

class GenreTrackSort <<static>> {
  +{static} Newest = "newest"
  +{static} MostPlayed = "most-played"
}
class GetGenreTracksQuery {
  +string Slug
  +string Sort
  +int Page
}
class GetGenreTracksQueryHandler {
  +{static} int PageSize = 50
  +Handle(q: GetGenreTracksQuery): Task<Result<GenreTracksDto>>
}
class GenreTracksDto {
  +string Slug
  +string Name
  +string Description
  +int Tone
  +int TrackCount
  +string Sort
  +int Page
  +int PageSize
  +IReadOnlyList<TrackSummaryDto> Tracks
}
class Track {
  +Guid Id
  +Guid? GenreId
  +DateTimeOffset AddedAt
  +long PlayCount
  +bool Withdrawn
}
GetGenreTracksQuery --> GenreTrackSort
GetGenreTracksQueryHandler ..> GetGenreTracksQuery : handles
GetGenreTracksQueryHandler ..> Track : reads
GetGenreTracksQueryHandler ..> GenreTracksDto : returns
@enduml
