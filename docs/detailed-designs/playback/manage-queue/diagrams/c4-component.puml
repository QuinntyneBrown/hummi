@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage the queue

Container_Boundary(spa, "Hummi web application") {
  Component(panel, "QueuePanelComponent", "Shell part in @hummi/player", "Renders hm-queue-drawer over PlayerStore\nand loads Then, more {genre}")
  Component(host, "TrackMenuHostComponent", "Shell part in @hummi/player", "Renders hm-track-menu; Play next and Add\nto queue edit the queue and show a toast")
  Component(player, "PlayerStore", "Signal store in @hummi/api", "Owns the queue, upNext, addToQueue,\nplayNext, removeUpNext and clearUpNext")
  Component(overlays, "PlayerOverlays", "Signal store in @hummi/api", "queueOpen and trackMenu")
  Component(toast, "ToastService", "Service in @hummi/components", "Queues toast pills in hm-toast-region\n(L2-041)")
  Component(genres, "GenresApi", "Typed HTTP service in @hummi/api", "GET /api/genres/{slug}/tracks")
}
Container_Boundary(api, "Hummi.Api") {
  Component(ctl, "GenresController", "ASP.NET Core controller", "GET /api/genres/{slug}/tracks through\nGetGenreTracksQuery")
}
Rel(host, player, "playNext(track), addToQueue(track)")
Rel(host, toast, "'Added “{title}” to your queue' /\n'“{title}” will play next' (L2-016)")
Rel(panel, player, "upNext(), removeUpNext(i), clearUpNext()")
Rel(panel, overlays, "closeQueue()")
Rel(panel, genres, "tracks(genreSlug, most-played)")
Rel(genres, ctl, "GET /api/genres/{slug}/tracks")
@enduml
