@startuml
title UML sequence behaviour — Add to queue and clear it
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "TrackMenuHostComponent" as menu
  participant "QueuePanelComponent" as panel
  participant "PlayerStore" as player
  participant "ToastService" as toast
  participant "GenresApi" as genres
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "GenresController" as ctl
end box
u -> menu : More actions, then Add to queue
menu -> player : addToQueue(track) (L2-016)
menu -> toast : show("Added “{title}” to your queue") (L2-041)
u -> panel : Queue in the player bar, Now playing or Q
panel -> player : current(), upNext()
panel -> genres : tracks(genreSlug, most-played)
genres -> ctl : GET /api/genres/{slug}/tracks
ctl --> panel : Tracks
panel --> u : Now playing, Up next · {n}, Then, more {genre} (L2-016)
u -> panel : Clear
panel -> player : clearUpNext() (L2-016)
u -> panel : Escape or Close queue
panel -> panel : closeQueue() (L2-016)
@enduml
