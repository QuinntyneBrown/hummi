@startuml
title UML sequence behaviour — Add to queue and clear it
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "QueuePage" as page
  participant "TrackActionsMenu" as menu
  participant "PlayerStore" as player
  participant "ToastService" as toast
  participant "SessionStore" as session
  participant "QueueApi" as client
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "QueueController" as ctl
end box
box "Backend — Hummi Application and Domain" #ECFDF3
  participant "SaveQueueCommandHandler" as cmd
end box
box "Backend — Hummi Infrastructure" #FFF4E5
  participant "HummiDbContext" as ctx
  database "Hummi database" as db
end box
u -> menu : More actions > Add to queue on "Glass Rain"
menu -> player : playNext(track)
player --> menu : Inserted after current (L2-016)
menu -> toast : info "Added to queue" / "“Glass Rain” plays after the current track." (L2-016)
player -> session : isSignedIn()
opt signed in
  player -> client : save(queue)
  client -> ctl : PUT /api/me/queue
  ctl -> cmd : Send SaveQueueCommand
  cmd -> ctx : Upsert SavedQueue
  ctx -> db : MERGE
end
u -> page : Open /queue
page -> player : upNext()
player --> page : 4 tracks, 14 min
page --> u : Now playing, Next up, "4 tracks · 14 min" (L2-016)
u -> page : Activate Clear queue
page -> player : clearUpNext()
player --> page : Empty
page --> u : "Your queue is empty" with Open library (L2-016)
@enduml
