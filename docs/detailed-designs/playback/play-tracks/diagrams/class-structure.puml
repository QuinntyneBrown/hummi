@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Play tracks

enum PlayState {
  Idle
  Loading
  Playing
  Paused
  Stalled
}
class PlayerStore {
  +queue: Signal<TrackSummaryDto[]>
  +index: Signal<number>
  +state: Signal<PlayState>
  +positionSeconds: Signal<number>
  +currentTrack: Computed<TrackSummaryDto | null>
  +playList(tracks, start, shuffle?): void
  +toggle(): void
  +next(): void
  +previous(): void
  +seek(seconds: number): void
}
class PlayerBarComponent <<hm-player-bar>> {
  +metaLine(): string
}
class RecordPlayCommand {
  +Guid TrackId
  +Guid? ListenerId
  +string AnonymousSessionId
}
class RecordPlayCommandHandler {
  +Handle(c: RecordPlayCommand): Task<Result>
}
class PlayEvent {
  +Guid Id
  +Guid TrackId
  +Guid? ListenerId
  +DateTimeOffset PlayedAt
}
class Track {
  +long PlayCount
  +RegisterPlay(): void
}
PlayerStore --> PlayState
PlayerBarComponent ..> PlayerStore : reads
RecordPlayCommandHandler ..> RecordPlayCommand : handles
RecordPlayCommandHandler ..> PlayEvent : creates
RecordPlayCommandHandler --> Track : RegisterPlay()
@enduml
