@startuml
title UML sequence behaviour — Press a shortcut
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "AppShellComponent" as shell
  participant "ShortcutService" as keys
  participant "PlayerStore" as player
  participant "PlayerOverlays" as overlays
  participant "SearchStore" as search
end box
u -> shell : keydown
shell -> keys : handle(event)
alt text field focused, Ctrl/Alt/Meta, or Space on a focused control
  keys --> u : No shortcut; the key types or activates the control (L2-017)
else Space
  keys -> player : toggle() (L2-017)
else → or ←
  keys -> player : next() or previous() (L2-017)
else Q
  keys -> overlays : openQueue() (L2-017)
else /
  keys -> search : openWith() (L2-017)
else ?
  keys -> keys : dialogOpen = true (L2-017)
  shell --> u : Keyboard shortcuts dialog; page behind inert (L2-047)
end
@enduml
