@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Use keyboard shortcuts

Container_Boundary(spa, "Hummi web application") {
  Component(shell, "AppShellComponent", "Shell in the hummi application", "Passes document keydown to ShortcutService;\nmakes the page inert under the dialog")
  Component(keys, "ShortcutService", "Service in the hummi application", "Ignores text fields, Ctrl, Alt and Meta,\nand Space on a focused control; dispatches\nthe mapped action")
  Component(player, "PlayerStore", "Signal store in @hummi/api", "toggle(), next(), previous()")
  Component(overlays, "PlayerOverlays", "Signal store in @hummi/api", "openQueue()")
  Component(search, "SearchStore", "Signal store in @hummi/api", "openWith()")
  Component(dlg, "ShortcutsDialogComponent", "Dialog content in the hummi application", "Renders hm-dialog with hm-description-list\nof SHORTCUTS and Close")
}
Rel(shell, keys, "handle(event)")
Rel(keys, player, "Space, → / ← (L2-017)")
Rel(keys, overlays, "Q (L2-017)")
Rel(keys, search, "/ (L2-017)")
Rel(shell, dlg, "Render while dialogOpen() (L2-017)")
@enduml
