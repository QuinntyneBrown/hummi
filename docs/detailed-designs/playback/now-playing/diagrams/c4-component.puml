@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show Now playing

Container_Boundary(spa, "Hummi web application") {
  Component(page, "NowPlayingComponent", "Routed component in @hummi/player", "/now-playing: renders hm-player-layer for\nthe current track, or Nothing is playing")
  Component(layer, "PlayerLayerComponent", "hm-player-layer in @hummi/components", "Close, Playing from, cover, scrubber,\nShuffle and Repeat toggles, Save, Share,\nQueue, More actions, Up next, alert")
  Component(player, "PlayerStore", "Signal store in @hummi/api", "Owns the queue, Shuffle, Repeat, position\nand play state, and drives the\nHTMLAudioElement")
  Component(overlays, "PlayerOverlays", "Signal store in @hummi/api", "Queue drawer and track menu state")
  Component(audio, "HTMLAudioElement", "Browser media element", "Requests audio by byte range and reports\ntimeupdate, ended, stalled and error")
  Component(net, "ConnectivityService", "Service in @hummi/api", "Exposes online as a signal from\nnavigator.onLine and online/offline events")
}
Container_Boundary(api, "Hummi.Api") {
  Component(mctl, "MediaController", "ASP.NET Core controller", "GET /media/tracks/{id} by byte range")
}
Rel(page, layer, "Inputs and outputs")
Rel(page, player, "current(), upNext(), toggleShuffle(),\ntoggleRepeat()")
Rel(page, overlays, "openQueue(), openTrackMenu()")
Rel(player, net, "online() (L2-015)")
Rel(player, audio, "src; currentTime = resumeFrom; play()")
Rel(audio, mctl, "GET /media/tracks/{id}")
@enduml
