@startuml
title UML sequence behaviour — Open Now playing and recover from a dropped connection
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "NowPlayingComponent" as page
  participant "PlayerStore" as player
  participant "HTMLAudioElement" as audio
  participant "ConnectivityService" as net
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "MediaController" as mctl
end box
u -> page : Expand, cover or title in the player bar (/now-playing)
page -> player : current(), upNext()
alt nothing playing
  player --> page : null
  page --> u : "Nothing is playing" with Browse genres (L2-015)
else track loaded
  player --> page : Track, position, Shuffle, Repeat
  page --> u : Playing from {genre}, cover, scrubber, controls, Up next (L2-015)
end
u -> page : Activate Shuffle
page -> player : toggleShuffle(): shuffle the tracks after the current one (L2-015)
net --> player : offline event
player -> audio : pause(); resumeFrom = position
player --> page : Danger alert "Playback stopped" (L2-015)
net --> player : online event
player -> audio : src = /media/tracks/{id}; currentTime = resumeFrom; play()
audio -> mctl : GET /media/tracks/{id} Range
u -> page : Close or Escape
page -> page : history.back() (Home when opened directly) (L2-015)
@enduml
