@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Show Now playing

class NowPlayingComponent {
  -cameFromApp: boolean
  +close(): void
  +openQueue(): void
  +openMenu(): void
}
class PlayerLayerComponent {
  +track: TrackItem | null
  +shuffle: boolean
  +repeat: boolean
  +upNext: TrackItem[]
  +resumeFrom: number | null
}
class PlayerStore {
  +current: Signal<TrackSummaryDto | null>
  +upNext: Signal<TrackSummaryDto[]>
  +shuffle: Signal<boolean>
  +repeat: Signal<boolean>
  +resumeFrom: Signal<number | null>
  +toggleShuffle(): void
  +toggleRepeat(): void
  -unshuffled: TrackSummaryDto[] | null
}
class ConnectivityService {
  +online: Signal<boolean>
}
NowPlayingComponent *-- PlayerLayerComponent : renders
NowPlayingComponent ..> PlayerStore : reads and commands
PlayerStore --> ConnectivityService : stalls offline, resumes online
@enduml
