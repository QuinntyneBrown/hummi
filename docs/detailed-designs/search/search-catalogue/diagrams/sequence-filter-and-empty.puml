@startuml
title UML sequence behaviour — Filter by type and repeat a recent search
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "SearchPage" as page
  participant "RecentSearchesStore" as recent
  participant "SearchApi" as client
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "SearchController" as ctl
end box
u -> page : Select the Tracks tab
page -> client : search("rain", Track)
client -> ctl : GET /api/search?q=rain&type=track
ctl --> client : Track hits only (L2-006)
client --> page : Results
page --> u : Only tracks shown
u -> page : Open /search with no query
page -> recent : items()
recent --> page : Previous queries
page --> u : "Search Hummi", recent searches, Try a genre (L2-007)
u -> page : Select a recent search
page -> client : search(query, All)
@enduml
