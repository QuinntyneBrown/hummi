@startuml
title UML sequence behaviour — Open the overlay and repeat a recent search
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "SearchOverlayComponent" as overlay
  participant "RecentSearchesStore" as recent
  participant "GenresApi" as genres
  participant "SearchApi" as client
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "GenresController" as gctl
  participant "SearchController" as ctl
end box
u -> overlay : Open search with an empty query
overlay -> recent : items()
recent --> overlay : Previous queries (localStorage)
overlay -> genres : directory()
genres -> gctl : GET /api/genres
gctl --> genres : Genres with track counts
overlay --> u : "Recent" and "Browse by sound" (L2-007)
u -> overlay : Select a recent search
overlay -> client : search(query)
client -> ctl : GET /api/search?q=query
ctl --> client : Results
overlay --> u : Query filled, results shown (L2-007)
u -> overlay : Select a genre tile
overlay --> u : Genre page opens, layer closes (L2-007)
@enduml
