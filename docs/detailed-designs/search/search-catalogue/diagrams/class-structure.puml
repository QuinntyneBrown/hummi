@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Search the catalogue

class SearchCatalogueQuery {
  +string Text
}
class SearchCatalogueQueryHandler {
  +Handle(q: SearchCatalogueQuery): Task<Result<SearchResultsDto>>
}
interface ISearchIndex {
  +SearchAsync(text: string, artistTake: int, trackTake: int): Task<SearchHits>
}
class SqlSearchIndex
class SearchUnavailableException
class SearchHits {
  +IReadOnlyList<ArtistHitDto> Artists
  +IReadOnlyList<TrackSummaryDto> Tracks
}
class ArtistHitDto {
  +string Slug
  +string Name
}
class SearchResultsDto {
  +string Query
  +TrackSummaryDto? TopResult
  +IReadOnlyList<ArtistHitDto> Artists
  +IReadOnlyList<TrackSummaryDto> Songs
}
class RecentSearchesStore {
  +items: Signal<string[]>
  +add(query: string): void
}
class SearchStore {
  +open: Signal<boolean>
  +query: Signal<string>
  +openWith(query: string): void
  +close(): void
}
SearchCatalogueQueryHandler ..> SearchCatalogueQuery : handles
SearchCatalogueQueryHandler --> ISearchIndex : uses
ISearchIndex <|.. SqlSearchIndex
ISearchIndex ..> SearchHits : returns
SqlSearchIndex ..> SearchUnavailableException : throws
SearchHits --> ArtistHitDto
SearchCatalogueQueryHandler ..> SearchResultsDto : returns
@enduml
