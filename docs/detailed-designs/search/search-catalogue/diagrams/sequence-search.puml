@startuml
title UML sequence behaviour — Run a search
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "AppShellComponent" as shell
  participant "SearchOverlayComponent" as overlay
  participant "SearchApi" as client
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "SearchController" as ctl
end box
box "Backend — Hummi Application and Domain" #ECFDF3
  participant "SearchCatalogueQueryHandler" as q
end box
box "Backend — Hummi Infrastructure" #FFF4E5
  participant "SqlSearchIndex" as idx
  database "Hummi database" as db
end box
u -> shell : Activate "Search songs and artists" or press /
shell -> overlay : Open; query field takes focus (L2-006)
u -> overlay : Type "pan"
overlay -> overlay : 250 ms later: skeleton rows (L2-006)
overlay -> client : search("pan")
client -> ctl : GET /api/search?q=pan
ctl -> q : Send SearchCatalogueQuery
q -> idx : SearchAsync("pan", 3, 7)
idx -> db : SELECT ... WHERE Title LIKE '%pan%'
db --> idx : Rows
idx --> q : Ranked hits
q --> ctl : Result<SearchResultsDto>
alt hits found
  ctl --> client : 200
  client --> overlay : Results
  overlay --> u : Top result, Artists, Songs (L2-006)
else no hits
  ctl --> client : 200, no songs or artists
  overlay --> u : "Nothing matches “…”" (L2-007)
else index unreachable
  ctl --> client : 503 ProblemDetails
  overlay --> u : "Search isn’t working right now", query kept (L2-007)
end
u -> overlay : Close or Escape
overlay -> shell : close(); page beneath unchanged (L2-006)
@enduml
