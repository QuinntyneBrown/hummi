@startuml
title UML sequence behaviour — Prompt a signed-out listener
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "SignInGate" as gate
  participant "SessionStore" as session
  participant "DialogService" as dialogs
  participant "SignInPromptDialog" as dlg
  participant "Router" as router
end box
u -> gate : Like, add to playlist, follow or create (signed out)
gate -> session : isSignedIn()
session --> gate : false
gate -> dialogs : open(SignInPromptDialog)
dialogs -> dlg : Render "Sign in to save this" (L2-032)
gate --> u : Nothing saved (L2-032)
alt Not now
  dlg --> u : Close, stay on page (L2-032)
else Sign in / Create account
  dlg -> router : /sign-in or /sign-up?returnUrl= (L2-032)
end
@enduml
