@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Sign in

class Listener {
  +Guid Id
  +string DisplayName
  +string Email
  +string PasswordHash
  +DateTimeOffset? EmailConfirmedAt
  +bool EmailConfirmed
  +{static} Create(name, email, hash, now): Listener
  +ConfirmEmail(now): void
}

class SignInCommand {
  +string Email
  +string Password
  +bool KeepSignedIn
}
class SignInCommandHandler {
  +Handle(c): Task<Result<SessionGrant>>
}
class RefreshToken {
  +string TokenHash
  +Guid ListenerId
  +DateTimeOffset ExpiresAt
  +bool Persistent
  +DateTimeOffset? RevokedAt
  +{static} Issue(listenerId, persistent, now): (RefreshToken, secret)
  +IsActive(now): bool
  +Revoke(now): void
}
class SessionCookies {
  +Write(response, SignedIn): void
  +{static} Clear(response): void
}
SignInCommandHandler ..> SignInCommand : handles
SignInCommandHandler --> Listener : verifies
SignInCommandHandler ..> RefreshToken : issues
SessionCookies ..> RefreshToken : writes the secret as hm_refresh
@enduml
