@startuml
title UML sequence behaviour — Share and copy a link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listener" as u
box "Frontend — Hummi web application (Angular)" #E0F2FE
  participant "ShareDialog" as dlg
  participant "Clipboard" as clip
  participant "SharesApi" as client
  participant "ToastService" as toast
end box
box "Backend — Hummi.Api application" #D1FADF
  participant "SharesController" as ctl
end box
box "Backend — Hummi Application and Domain" #ECFDF3
  participant "GetOrCreateShareLinkCommandHandler" as cmd
  participant "ShareLink.NewCode" as gen
end box
box "Backend — Hummi Infrastructure" #FFF4E5
  participant "HummiDbContext" as ctx
  database "Hummi database" as db
end box
u -> dlg : Activate Share on "Slow Orbit"
dlg -> client : getLink(Track, id)
client -> ctl : POST /api/shares {type, id}
ctl -> cmd : Send GetOrCreateShareLinkCommand
cmd -> ctx : Find ShareLink by target
alt none
  cmd -> gen : Next()
  gen --> cmd : Code
  cmd -> ctx : Insert ShareLink
  ctx -> db : INSERT
end
cmd --> ctl : ShareLinkDto
ctl --> client : 200 https://hummi.example/s/{code}
dlg --> u : "Share “Slow Orbit”", link field, Copy link, caption (L2-025)
u -> dlg : Copy link
dlg -> clip : copy(url)
clip --> dlg : true
dlg --> u : Button "Copied", status "Link copied. Anyone with it can listen without an account." (L2-025)
opt copy from a row's More actions
  dlg -> toast : success "Link copied" "Anyone with it can listen." with Undo (L2-025)
end
@enduml
